{
  "expo": {
    "name": "Nutrail",
    "slug": "nutrail",
    "scheme": "nutrail",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.nutrail.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.nutrail.app",
      "predictiveBackGestureEnabled": false
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Nutrail usa suas fotos para anexar a imagem da refeição.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
